        [65, ["minecraft:stonebrick", "minecraft:mud_bricks", "minecraft:end_bricks", "minecraft:deepslate_brick_wall", "minecraft:deepslate_brick_stairs", "minecraft:deepslate_bricks", "minecraft:deepslate_tile_wall", "minecraft:deepslate_tile_stairs", "minecraft:deepslate_tiles", "minecraft:mossy_stone_brick_stairs", "minecraft:end_brick_stairs", "minecraft:mud_brick_wall"]]
    ];
    mut idsBedrock = Object.claves(json);
    mut porciento100 = idsBedrock.longitud;
    para (mut idRBnum = 0; idRBnum < porciento100; idRBnum++) {
        mut idRB = idsBedrock[idRBnum];
        mut jsonidRB = json[idRB];
        para (mut listaClasica de traductor) {
            si(listaClasica[1].indiceDe(jsonidRB[nombreBedrock]) < 0){
                continuar;
            }
            si(jsonidRB[estadoJava]){
                eliminar jsonidRB[estadoJava];
            }
            si(jsonidRB[javaWaterlog]){
                eliminar jsonidRB[javaWaterlog];
            }
            jsonidRB[estadoClassico] = listaClasica[0];
        }
        para (const listaCC de traductorCC) {
            si(listaCC[1].indiceDe(jsonidRB[nombreBedrock]) < 0){
                continuar;
            }
            jsonidRB[estadoClassicube] = listaCC[0];
        }
        mut porcientoPro = (idRBnum / porciento100) * 100;
        consola.info(porcientoPro.fijarDecimales(2) + porciento);
    }
    mut jsonNuevo = JSON./*aTexto*/stringify(json, nulo, "\t").reemplazar(/"_(\d+)"\s*:\s*\{/g, '"$1": {');
    esperar fs.writeFile(ruta, jsonNuevo);
    consola.info("Bloques Traducidos con Exito!");
}
traducirBloques();