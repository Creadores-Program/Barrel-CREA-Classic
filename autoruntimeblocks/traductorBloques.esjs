const fs = require("fs").promises;
asincrono funcion traducirBloques() {
    mut porciento = '%';
    mut ruta = "../src/main/resources/runtime_blocks.json";
    consola.info("Leyendo Archivo...");
    mut datos = esperar fs.readFile(ruta, 'utf-8');
    mut json = JSON.analizar(datos.reemplazar(/"(\d+)"\s*:\s*\{/g, '"_$1": {'));
    mut estadoClassico = "classic_default_state";
    mut estadoClassicube = "classic_default_state1";
    mut nombreBedrock = "bedrock_name";
    mut estadoJava = "java_default_state";
    mut javaWaterlog = "java_waterlogged_state";
    mut traductor = [
        [0, ["minecraft:snow_layer", "minecraft:monster_egg", "minecraft:waterlily"]],
        [1, ["minecraft:polished_basalt", "minecraft:packed_mud"]],
        [2, ["minecraft:mycelium"]],
        [3, ["minecraft:brown_mushroom_block"]],
        [4, ["minecraft:netherrack", "minecraft:basalt", "minecraft:stonebrick", "minecraft:mud_bricks", "minecraft:end_stone", "minecraft:cobblestone_wall"]],
        [5, ["minecraft:oak_hanging_sign", "minecraft:spruce_hanging_sign", "minecraft:birch_hanging_sign", "minecraft:acacia_hanging_sign", "minecraft:cherry_hanging_sign", "minecraft:jungle_hanging_sign", "minecraft:dark_oak_hanging_sign", "minecraft:crimson_hanging_sign", "minecraft:warped_hanging_sign", "minecraft:mangrove_hanging_sign", "minecraft:bamboo_hanging_sign", "minecraft:jukebox", "minecraft:oak_fence", "minecraft:trapdoor", "minecraft:spruce_trapdoor", "minecraft:birch_trapdoor", "minecraft:jungle_trapdoor", "minecraft:acacia_trapdoor", "minecraft:cherry_trapdoor", "minecraft:dark_oak_trapdoor", "minecraft:mangrove_trapdoor", "minecraft:bamboo_trapdoor", "minecraft:ladder", "minecraft:fence_gate", "minecraft:cocoa", "minecraft:tripwire_hook", "minecraft:trip_wire", "minecraft:spruce_stairs", "minecraft:birch_stairs", "minecraft:jungle_stairs", "minecraft:trapped_chest"]],
        [6, ["minecraft:reeds", "minecraft:pumpkin_stem", "minecraft:melon_stem", "minecraft:vine", "minecraft:flower_pot", "minecraft:carrots", "minecraft:potatoes"]],
        [9, ["minecraft:portal", "minecraft:end_portal"]],
        [12, ["minecraft:soul_sand", "minecraft:soul_soil"]],
        [13, ["minecraft:clay"]],
        [16, ["minecraft:lit_redstone_ore", "minecraft:redstone_ore", "minecraft:lit_deepslate_redstone_ore", "minecraft:deepslate_redstone_ore"]],
        [20, ["minecraft:ice", "minecraft:snow", "minecraft:white_stained_glass", "minecraft:orange_stained_glass", "minecraft:magenta_stained_glass", "minecraft:light_blue_stained_glass", "minecraft:yellow_stained_glass", "minecraft:lime_stained_glass", "minecraft:pink_stained_glass", "minecraft:gray_stained_glass", "minecraft:light_gray_stained_glass", "minecraft:cyan_stained_glass", "minecraft:purple_stained_glass", "minecraft:blue_stained_glass", "minecraft:brown_stained_glass", "minecraft:green_stained_glass", "minecraft:red_stained_glass", "minecraft:black_stained_glass", "minecraft:glass_pane", "minecraft:end_portal_frame", "minecraft:beacon"]],
        [21, ["minecraft:red_mushroom_block"]],
        [22, ["minecraft:carved_pumpkin", "minecraft:lit_pumpkin", "minecraft:pumpkin", "minecraft:command_block"]],
        [23, ["minecraft:glowstone", "minecraft:lit_redstone_lamp"]],
        [24, ["minecraft:cactus", "minecraft:melon_block"]],
        [25, ["minecraft:emerald_block"]],
        [28, ["minecraft:enchanting_table"]],
        [37, ["minecraft:lever", "minecraft:wooden_pressure_plate", "minecraft:spruce_pressure_plate", "minecraft:birch_pressure_plate", "minecraft:jungle_pressure_plate", "minecraft:acacia_pressure_plate", "minecraft:cherry_pressure_plate", "minecraft:dark_oak_pressure_plate", "minecraft:mangrove_pressure_plate", "minecraft:bamboo_pressure_plate"]],
        [38, ["minecraft:redstone_torch", "minecraft:unlit_redstone_torch"]],
        [39, ["minecraft:stone_pressure_plate", "minecraft:stone_button", "minecraft:soul_torch", "minecraft:wooden_button", "minecraft:spruce_button", "minecraft:birch_button", "minecraft:jungle_button", "minecraft:acacia_button", "minecraft:cherry_button", "minecraft:dark_oak_button", "minecraft:mangrove_button", "minecraft:bamboo_button"]],
        [40, ["minecraft:glow_lichen", "minecraft:nether_wart"]],
        [42, ["minecraft:iron_door", "minecraft:iron_bars", "minecraft:chain", "minecraft:cauldron", "minecraft:anvil"]],
        [43, ["minecraft:brewing_stand"]],
        [44, ["minecraft:cake", "minecraft:powered_repeater", "minecraft:unpowered_repeater"]],
        [45, ["minecraft:brick_stairs", "minecraft:nether_brick", "minecraft:nether_brick_fence", "minecraft:nether_brick_stairs", "minecraft:redstone_lamp"]],
        [48, ["minecraft:emerald_ore", "minecraft:deepslate_emerald_ore"]],
        [49, ["minecraft:dragon_egg", "minecraft:ender_chest", "minecraft:skull"]]
    ];
    mut traductorCC = [
        [51, ["minecraft:vine", "minecraft:ladder"]],
        [53, ["minecraft:snow_layer"]],
        [57, ["minecraft:brown_mushroom_block", "minecraft:cocoa"]],
        [60, ["minecraft:ice", "minecraft:snow"]],
        [62, ["minecraft:lit_redstone_lamp"]],
        [64, ["minecraft:jukebox"]],
        [65, ["minecraft:stonebrick", "minecraft:mud_bricks"]]
    ];
    mut idsBedrock = Object.claves(json);
    mut porciento100 = idsBedrock.longitud;
    para (mut idRBnum = 0; idRBnum < porciento100; idRBnum++) {
        mut idRB = idsBedrock[idRBnum];
        mut jsonidRB = json[idRB];
        para (mut listaClasica de traductor) {
            si(listaClasica[1].indiceDe(jsonidRB[nombreBedrock]) < 0){
                continuar;
            }
            si(jsonidRB[estadoJava]){
                eliminar jsonidRB[estadoJava];
            }
            si(jsonidRB[javaWaterlog]){
                eliminar jsonidRB[javaWaterlog];
            }
            jsonidRB[estadoClassico] = listaClasica[0];
        }
        para (const listaCC de traductorCC) {
            si(listaCC[1].indiceDe(jsonidRB[nombreBedrock]) < 0){
                continuar;
            }
            jsonidRB[estadoClassicube] = listaCC[0];
        }
        mut porcientoPro = (idRBnum / porciento100) * 100;
        consola.info(porcientoPro.fijarDecimales(2) + porciento);
    }
    mut jsonNuevo = JSON./*aTexto*/stringify(json, nulo, "\t").reemplazar(/"_(\d+)"\s*:\s*\{/g, '"$1": {');
    esperar fs.writeFile(ruta, jsonNuevo);
    consola.info("Bloques Traducidos con Exito!");
}
traducirBloques();