        [51, ["minecraft:vine", "minecraft:ladder"]],
        [52, ["minecraft:red_sandstone", "minecraft:red_sandstone_stairs", "minecraft:sandstone", "minecraft:smooth_red_sandstone_stairs", "minecraft:smooth_sandstone_stairs"]],
